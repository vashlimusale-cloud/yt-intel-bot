# --- Secrets -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
TELEGRAM_CHAT_ID=

# --- GitHub cloud batch (auto-filled by the one-click setup) -----------------
GITHUB_REPO=
GITHUB_PAT=
GITHUB_BRANCH=main

# --- Execution engine (AUTO | RENDER | CLOUD | LOCAL) ------------------------
BOT_EXECUTION_MODE=AUTO

# --- AI intelligence (optional) ----------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
ENABLE_AUDIO_TRANSCRIPTION=false
YOUTUBE_COOKIES_B64=

# --- Plugin API / MCP auth (optional) ----------------------------------------
PLUGIN_API_KEY=
PUBLIC_BASE_URL=

# --- Optional AI niche refinement fallback -----------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
