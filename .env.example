# --- Secrets -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
TELEGRAM_CHAT_ID=

# --- GitHub cloud batch (auto-filled by the one-click setup) -----------------
GITHUB_REPO=
GITHUB_PAT=
GITHUB_BRANCH=main

# --- Cloud routing -----------------------------------------------------------
# true  = even single links are scraped on GitHub Actions (default on Render)
# false = single links are scraped locally, /batch always uses GitHub Actions
CLOUD_SINGLE_LINKS=false

# --- Optional AI niche refinement (OpenRouter / DeepSeek / OpenAI-compatible) -
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
